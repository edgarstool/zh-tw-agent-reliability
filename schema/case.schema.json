{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edgarstool/zh-tw-agent-reliability/master/schema/case.schema.json",
  "title": "Traditional Chinese Long-Horizon Agent Reliability Case",
  "type": "object",
  "required": [
    "id",
    "title_zh",
    "title_en",
    "status",
    "primary_category",
    "categories",
    "source_type",
    "scenario",
    "task",
    "context_conditions",
    "validators",
    "scoring",
    "privacy",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ZH-TW-LHAR-[0-9]{3}$"
    },
    "title_zh": { "type": "string", "minLength": 1 },
    "title_en": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "pilot", "validated"]
    },
    "primary_category": {
      "type": "string",
      "enum": ["CTX", "INS", "TOOL", "CMP", "REC", "HCI", "LNG"]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["CTX", "INS", "TOOL", "CMP", "REC", "HCI", "LNG"]
      }
    },
    "source_type": {
      "const": "anonymized-practitioner-incident"
    },
    "language": {
      "type": "string",
      "const": "zh-TW"
    },
    "scenario": {
      "type": "object",
      "required": ["summary_zh", "environment", "prior_constraints"],
      "properties": {
        "summary_zh": { "type": "string" },
        "environment": {
          "type": "object",
          "required": ["os", "shell", "tools"],
          "properties": {
            "os": { "type": "string" },
            "shell": { "type": "string" },
            "tools": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "prior_constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["user_message_zh", "expected_behavior"],
      "properties": {
        "user_message_zh": { "type": "string" },
        "expected_behavior": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "context_conditions": {
      "type": "object",
      "required": ["minimal", "compact", "structured"],
      "properties": {
        "minimal": { "type": "string" },
        "compact": { "type": "string" },
        "structured": { "type": "object" }
      },
      "additionalProperties": false
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["contains", "not_contains", "regex", "manual_rubric", "json_schema"]
          },
          "target": { "type": ["string", "null"] },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "required": ["dimensions", "scale"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "context_retention",
              "instruction_persistence",
              "tool_selection",
              "completion_integrity",
              "recovery_quality",
              "human_control",
              "language_robustness"
            ]
          }
        },
        "scale": {
          "type": "object",
          "required": ["0", "1", "2"],
          "properties": {
            "0": { "type": "string" },
            "1": { "type": "string" },
            "2": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["de_identified", "contains_secrets", "notes"],
      "properties": {
        "de_identified": { "const": true },
        "contains_secrets": { "const": false },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}