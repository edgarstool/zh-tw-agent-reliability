{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edgarstool/zh-tw-agent-reliability/master/schema/run-manifest.schema.json",
  "title": "Traditional Chinese Long-Horizon Agent Reliability Run Manifest",
  "type": "object",
  "required": ["format", "created_at", "execution_mode", "api_calls_made", "api_calls_made_by_harness", "runs"],
  "properties": {
    "format": {"const": "zh-tw-agent-reliability.run-manifest/v0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "execution_mode": {"enum": ["structural_smoke", "external_response", "api"]},
    "api_calls_made": {"type": "boolean"},
    "api_calls_made_by_harness": {"const": false},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "context_condition", "repetition", "prompt_format", "prompt_hash", "request_timestamp", "response_provenance", "token_usage", "estimated_cost_usd", "validator_results", "final_state"],
        "properties": {
          "case_id": {"type": "string"},
          "context_condition": {"enum": ["minimal", "compact", "structured"]},
          "repetition": {"type": "integer", "minimum": 1},
          "model": {"type": ["string", "null"]},
          "prompt_format": {"const": "zh-tw-agent-reliability.case-context/v0.1"},
          "prompt_hash": {"pattern": "^sha256:[a-f0-9]{64}$"},
          "request_timestamp": {"type": "string", "format": "date-time"},
          "raw_response_ref": {"type": ["string", "null"]},
          "response_provenance": {"enum": ["structural_smoke", "external_api", "external_manual", "unknown"]},
          "token_usage": {"type": ["object", "null"]},
          "estimated_cost_usd": {"type": ["number", "null"]},
          "validator_results": {"type": "array"},
          "final_state": {"enum": ["passed", "pending_manual_review", "failed", "error"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
